# HTTP and local persistence
GARUDA_ADDRESS=:8080
GARUDA_PUBLIC_URL=http://localhost:8080
GARUDA_DATA_FILE=./data/garuda.json
GARUDA_ALLOWED_ORIGINS=http://localhost:3000
GARUDA_LOG_LEVEL=info

# Local demo mode. Set false in every shared/staging/production environment.
GARUDA_DEMO_MODE=true
GARUDA_EXPOSE_RESET_TOKEN=true
# Select local Garuda password/Google auth or Supabase Auth explicitly.
GARUDA_AUTH_MODE=local
GARUDA_JWT_SECRET=replace-with-at-least-32-random-characters
GARUDA_VISITOR_HMAC_KEY=replace-with-a-separate-32-byte-random-secret
GARUDA_ACCESS_TOKEN_TTL=24h
GARUDA_REFRESH_TOKEN_TTL=720h
GARUDA_PASSWORD_RESET_TTL=1h
GARUDA_EMAIL_VERIFICATION_TTL=24h
AUTH_RESET_URL=http://localhost:3000/auth/reset-password
AUTH_VERIFY_URL=http://localhost:3000/auth/verify-email

# Transactional mail for GARUDA_AUTH_MODE=local outside demo mode. Use a
# SendGrid verified sender. The API key stays server-side.
SENDGRID_API_KEY=
SENDGRID_API_URL=https://api.sendgrid.com/v3
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Garuda
SENDGRID_REPLY_TO=

# Product display. Stripe Checkout still selects STRIPE_PRICE_ID server-side.
GARUDA_PLAN_AMOUNT_CENTS=1700
GARUDA_PLAN_CURRENCY=usd

# Supabase Auth is used only when GARUDA_AUTH_MODE=supabase. These settings may
# coexist with local auth for Supabase-hosted RAG. The service-role key is
# intentionally not used by the Go API's browser auth flow.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Identity Services ID-token audience. No Google client secret is used.
GOOGLE_OAUTH_CLIENT_ID=

# Stripe USD $17/month subscription
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# STRIPE_PRICE_ID_STARTER_17 is accepted as an alias.
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/checkout?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/app/billing
STRIPE_API_URL=https://api.stripe.com/v1

# Gemini through its OpenAI-compatible API. LLM_API_KEY can be used instead of
# GEMINI_API_KEY for any compatible provider.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
LLM_MODEL=gemini-3.7-flash

# Free semantic embeddings/search through the included Supabase Edge Functions.
# Use a separate 32+ byte shared secret, not SUPABASE_SERVICE_ROLE_KEY.
RAG_EDGE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1
RAG_EDGE_BEARER_TOKEN=

# Composio integration broker (optional; integrations degrade to unavailable
# when unset). Use a PLATFORM key from dashboard.composio.dev project settings,
# sent as x-api-key -- not a Connect/MCP consumer key.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3

# Deepgram speech-to-text (optional; voice onboarding degrades to typing when unset)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
