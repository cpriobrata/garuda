[Unit]
Description=Garuda API
# Never stop trying to restart. systemd defaults to giving up after 5 failures in
# a 10s window, leaving the service down until someone logs in -- for a service
# whose whole job is to be reachable, that default is the likeliest cause of an
# outage. These two keys belong in [Unit], not [Service].
StartLimitIntervalSec=0
StartLimitBurst=0
Documentation=https://github.com/cpriobrata/garuda
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=garuda
Group=garuda
WorkingDirectory=/opt/garuda
ExecStart=/opt/garuda/garuda-api
EnvironmentFile=/opt/garuda/.env
# Never stop trying. systemd defaults to StartLimitBurst=5 in a 10s window, after
# which it gives up permanently and the service stays down until someone logs in.
# For a service whose whole job is to be reachable, that default is the single
# most likely cause of an outage.
Restart=always
RestartSec=2

# The JSON store is the whole database. It is the only path that must be writable.
StateDirectory=garuda
ReadWritePaths=/opt/garuda/data

# The service is a plain HTTP listener behind Caddy; it needs nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
