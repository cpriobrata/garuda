# Caddy terminates TLS and proxies to the Go API on loopback.
# Requires an A record: api.garuda.ravan.ai -> this server's public IP.
api.garuda.ravan.ai {
	# Everything EXCEPT the widget. The API already serves /widget.js
	# pre-compressed at maximum level, cached once at startup, with a separate
	# ETag per variant. Letting Caddy encode it too means Caddy asks upstream for
	# identity, throws that cached work away, and re-compresses 145KB on every
	# request -- and collapses the two variants onto one ETag while it is at it.
	@compressible not path /widget.js
	encode @compressible gzip zstd

	# The API sets its own CORS, security and cache headers. Do not duplicate them
	# here -- two sources of Access-Control-Allow-Origin is how origins get
	# silently widened.
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# The widget streams replies. Buffering them defeats the point.
		flush_interval -1
	}

	# Log to the journal (journalctl -u caddy). A file target would need a
	# ReadWritePaths exception in caddy.service, which is not worth the hole.
	log {
		format json
	}
}
