# Garuda API - production environment for api.garuda.ravan.ai
# Copy to /opt/garuda/.env, fill in every REPLACE value, chmod 600, chown garuda.
# Never commit the filled-in copy.

# --- Deployment identity -----------------------------------------------------
# GARUDA_ENVIRONMENT=production makes the server REFUSE to start in demo mode.
# Demo mode grants every account an active subscription, so this is the line that
# keeps billing switched on.
GARUDA_ENVIRONMENT=production
GARUDA_DEMO_MODE=false
GARUDA_EXPOSE_RESET_TOKEN=false

# --- HTTP --------------------------------------------------------------------
# Bind loopback only: Caddy is the only thing that should reach this port.
GARUDA_ADDRESS=127.0.0.1:8080
GARUDA_PUBLIC_URL=https://api.garuda.ravan.ai
GARUDA_ALLOWED_ORIGINS=https://garuda.ravan.ai
GARUDA_DATA_FILE=/opt/garuda/data/garuda.json
GARUDA_LOG_LEVEL=info

# Caddy runs on the same host, so the only trusted hop is loopback. Without this
# every visitor on earth shares one rate-limit bucket.
GARUDA_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Secrets (generate fresh; do NOT reuse the development values) ------------
# openssl rand -hex 32   (run twice; the two MUST differ)
GARUDA_JWT_SECRET=REPLACE_WITH_32_BYTE_RANDOM_HEX
GARUDA_VISITOR_HMAC_KEY=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_HEX
GARUDA_ACCESS_TOKEN_TTL=24h
GARUDA_REFRESH_TOKEN_TTL=720h
GARUDA_PASSWORD_RESET_TTL=1h
GARUDA_EMAIL_VERIFICATION_TTL=24h

# --- Frontend links (must be https outside demo mode) ------------------------
AUTH_RESET_URL=https://garuda.ravan.ai/auth/reset-password
AUTH_VERIFY_URL=https://garuda.ravan.ai/auth/verify-email

# --- Plan display ------------------------------------------------------------
GARUDA_PLAN_AMOUNT_CENTS=1700
GARUDA_PLAN_CURRENCY=usd

# --- Stripe (all three together, or none) ------------------------------------
# Use LIVE keys here, and a webhook endpoint pointing at
# https://api.garuda.ravan.ai/v1/webhooks/stripe
STRIPE_SECRET_KEY=REPLACE
STRIPE_WEBHOOK_SECRET=REPLACE
STRIPE_PRICE_ID=REPLACE
STRIPE_SUCCESS_URL=https://garuda.ravan.ai/checkout/success?checkout=success
STRIPE_CANCEL_URL=https://garuda.ravan.ai/checkout?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://garuda.ravan.ai/app/billing

# --- Model provider ----------------------------------------------------------
# Any OpenAI-compatible endpoint works with only these three values.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=REPLACE
GEMINI_API_KEY=REPLACE

# --- Email (required for local auth outside demo mode) -----------------------
# Use a RESTRICTED SendGrid key with mail.send only.
SENDGRID_API_KEY=REPLACE
SENDGRID_FROM_EMAIL=info@ravan.ai
SENDGRID_FROM_NAME="Agni By Ravan AI"
SENDGRID_REPLY_TO=info@ravan.ai

# --- Google sign-in ----------------------------------------------------------
# Add https://garuda.ravan.ai to Authorized JavaScript origins in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=REPLACE

# --- Integrations broker (Composio) ------------------------------------------
# The PLATFORM key, which starts ak_ and is sent as x-api-key. A Connect/MCP key
# starting ck_ uses a different header and will not work here.
# Restrict it to this server's IP: Composio disclosed a key breach in May 2026.
COMPOSIO_API_KEY=REPLACE
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3

# --- Voice onboarding (Deepgram) ---------------------------------------------
# nova-3 with language=multi. flux-general-en is English only -- do not use it.
DEEPGRAM_API_KEY=REPLACE
DEEPGRAM_MODEL=nova-3

# --- Retrieval (optional; both together or neither) --------------------------
# Absent, agents answer from the knowledge block in the system prompt instead.
# RAG_EDGE_URL=REPLACE
# RAG_EDGE_BEARER_TOKEN=REPLACE

# --- Supabase auth proxy (optional; both together or neither) -----------------
# Absent, local email/password and Google sign-in are the auth paths.
# SUPABASE_URL=REPLACE
# SUPABASE_ANON_KEY=REPLACE

# --- Error alerts to WhatsApp (optional) --------------------------------------
# Only panics and 5xx are sent, deduplicated per fingerprint and capped per hour.
#
# WhatsApp will NOT deliver free text to a number outside the 24-hour service
# window, and alerts fire at 3am by definition. So ALERT_WHATSAPP_TEMPLATE is
# effectively required: create an approved template whose body is a single {{1}}
# placeholder. Without it, alerts arrive only while the window happens to be open.
#
# ALERT_WHATSAPP_TOKEN=REPLACE            # Cloud API token for the sending number
# ALERT_WHATSAPP_PHONE_ID=REPLACE         # the sending number's id, not the number
# ALERT_WHATSAPP_TO=REPLACE               # who gets paged, digits with country code
# ALERT_WHATSAPP_TEMPLATE=garuda_alert
# ALERT_WHATSAPP_TEMPLATE_LANGUAGE=en
#
# Or any endpoint that accepts {"text": "..."} -- Slack, Discord, Zapier, n8n.
# This needs no template and no approval, so it is the one that works today.
# ALERT_WEBHOOK_URL=REPLACE
# ALERT_WEBHOOK_AUTH=REPLACE

# --- Meta conversions (optional) ---------------------------------------------
# Reports Garuda's own signups and purchases to the ad account, off the request
# path. Identifiers are SHA-256 hashed; the event id matches the browser pixel so
# the two deduplicate. Set NEXT_PUBLIC_META_PIXEL_ID on Vercel to the same id.
#
# REMOVE META_TEST_EVENT_CODE once verified: while it is set, every conversion
# lands in the Test Events tab and NONE are counted.
# META_PIXEL_ID=REPLACE
# META_CONVERSIONS_TOKEN=REPLACE
# META_TEST_EVENT_CODE=REPLACE

# --- Defaulted; set only to override -----------------------------------------
# Every one of these has a working default in config.Load. They exist so a
# provider's endpoint can be pointed elsewhere -- a sandbox, a proxy, a test
# double -- without a code change.
#
# GARUDA_AUTH_MODE=local        # auto|local|supabase; auto picks supabase if configured
# LLM_API_KEY=                  # alias for GEMINI_API_KEY
# LLM_CHAT_MODEL=               # alias for LLM_MODEL
# STRIPE_API_URL=https://api.stripe.com/v1
# SENDGRID_API_URL=https://api.sendgrid.com/v3
# META_API_URL=https://graph.facebook.com/v21.0
# ALERT_WHATSAPP_API_URL=https://graph.facebook.com/v21.0
