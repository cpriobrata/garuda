# Garuda API - production environment for api.garuda.ravan.ai
# Copy to /opt/garuda/.env, fill in every REPLACE value, chmod 600, chown garuda.
# Never commit the filled-in copy.

# --- Deployment identity -----------------------------------------------------
# GARUDA_ENVIRONMENT=production makes the server REFUSE to start in demo mode.
# Demo mode grants every account an active subscription, so this is the line that
# keeps billing switched on.
GARUDA_ENVIRONMENT=production
GARUDA_DEMO_MODE=false
GARUDA_EXPOSE_RESET_TOKEN=false

# --- HTTP --------------------------------------------------------------------
# Bind loopback only: Caddy is the only thing that should reach this port.
GARUDA_ADDRESS=127.0.0.1:8080
GARUDA_PUBLIC_URL=https://api.garuda.ravan.ai
GARUDA_ALLOWED_ORIGINS=https://garuda.ravan.ai
GARUDA_DATA_FILE=/opt/garuda/data/garuda.json
GARUDA_LOG_LEVEL=info

# Caddy runs on the same host, so the only trusted hop is loopback. Without this
# every visitor on earth shares one rate-limit bucket.
GARUDA_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Secrets (generate fresh; do NOT reuse the development values) ------------
# openssl rand -hex 32   (run twice; the two MUST differ)
GARUDA_JWT_SECRET=REPLACE_WITH_32_BYTE_RANDOM_HEX
GARUDA_VISITOR_HMAC_KEY=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_HEX
GARUDA_ACCESS_TOKEN_TTL=24h
GARUDA_REFRESH_TOKEN_TTL=720h
GARUDA_PASSWORD_RESET_TTL=1h
GARUDA_EMAIL_VERIFICATION_TTL=24h

# --- Frontend links (must be https outside demo mode) ------------------------
AUTH_RESET_URL=https://garuda.ravan.ai/auth/reset-password
AUTH_VERIFY_URL=https://garuda.ravan.ai/auth/verify-email

# --- Plan display ------------------------------------------------------------
GARUDA_PLAN_AMOUNT_CENTS=1700
GARUDA_PLAN_CURRENCY=usd

# --- Stripe (all three together, or none) ------------------------------------
# Use LIVE keys here, and a webhook endpoint pointing at
# https://api.garuda.ravan.ai/v1/webhooks/stripe
STRIPE_SECRET_KEY=REPLACE
STRIPE_WEBHOOK_SECRET=REPLACE
STRIPE_PRICE_ID=REPLACE
STRIPE_SUCCESS_URL=https://garuda.ravan.ai/checkout/success?checkout=success
STRIPE_CANCEL_URL=https://garuda.ravan.ai/checkout?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://garuda.ravan.ai/app/billing

# --- Model provider ----------------------------------------------------------
# Any OpenAI-compatible endpoint works with only these three values.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=REPLACE
GEMINI_API_KEY=REPLACE

# --- Email (required for local auth outside demo mode) -----------------------
# Use a RESTRICTED SendGrid key with mail.send only.
SENDGRID_API_KEY=REPLACE
SENDGRID_FROM_EMAIL=info@ravan.ai
SENDGRID_FROM_NAME="Agni By Ravan AI"
SENDGRID_REPLY_TO=info@ravan.ai

# --- Google sign-in ----------------------------------------------------------
# Add https://garuda.ravan.ai to Authorized JavaScript origins in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=REPLACE
